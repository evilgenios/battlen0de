# Copy to .env.local for local development. No secrets belong in this file
# or in git. Warpath credentials, database credentials, and encryption keys
# stay entirely on the backend.

# Server-only URL of the FastAPI backend. The browser never needs this value:
# requests go to /api/backend/* on the Next.js origin and the route handler
# forwards them server-to-server.
#
# Local:
BACKEND_API_BASE_URL=http://127.0.0.1:8000
#
# Production (Vercel): set BACKEND_API_BASE_URL to the HTTPS backend origin.
# Keep NEXT_PUBLIC_API_BASE_URL only temporarily if an older deployment still
# depends on it; the proxy supports it as a compatibility fallback, but new
# deployments should use the server-only variable above.


# Same random server-to-server value configured on the FastAPI host.
# This variable is server-only and must never be prefixed NEXT_PUBLIC_.
INTERNAL_PROXY_TOKEN=
