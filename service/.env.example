# Copy to .env for local development. Every value below is a PLACEHOLDER —
# no real credentials, keys, or connection strings belong in this file or
# any file checked into git.

# --- Database (Neon PostgreSQL) --------------------------------------------
# Use Neon's POOLED connection string (the one with "-pooler" in the
# hostname) — this service is a long-lived worker, not serverless, but the
# pooled endpoint is still the right choice given Neon's autosuspend
# behavior. See db/session.py's module docstring.
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# For repository, identity, migration and import tests
# against a real (throwaway!) Postgres database instead of skipping them:
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/warpath_test

# --- Secrets-at-rest encryption ---------------------------------------------
# Generate with: python -c "from app.security.crypto import generate_key; print(generate_key())"
# Never store this key in the database, in git, or in application logs.
WARPATH_ENCRYPTION_KEY=

# --- Website authentication -------------------------------------------------
# Safe defaults: password sessions required even with zero password users.
APP_ENV=production
AUTH_MODE=session
DASHBOARD_COOKIE_SECURE=true
# Local HTTP development ONLY: APP_ENV=development, AUTH_MODE=local,
# DASHBOARD_COOKIE_SECURE=false. Bind the service to 127.0.0.1.
# Production rejects local mode and insecure cookies at app construction.
# DEV_USER_EMAIL alone NEVER bypasses authentication.
DEV_USER_EMAIL=
DEV_USER_ROLE=member

# Marketplace preview is the default. Public real listings/inquiries require
# all four explicit attestations; checkout, offers, transfers and uploads are
# not implemented and remain disabled regardless of these settings.
MARKETPLACE_PUBLIC_ENABLED=false
MARKETPLACE_PUBLISHER_APPROVED=false
MARKETPLACE_LEGAL_APPROVED=false
MARKETPLACE_PROVIDER_APPROVED=false
# For local admin tools explicitly set DEV_USER_ROLE=admin.

# --- Operator bootstrap for email linking ----------------------------------
# Server-only credentials for a dedicated operator-controlled Warpath session.
# Never copied from a customer's database account. Missing config => HTTP 503.
WARPATH_APP_UID=
WARPATH_APP_TOKEN=
# Client build/device metadata for newly linked accounts; fill from a valid
# operator configuration. Validated before sending a linking code.
WARPATH_APP_ID=
WARPATH_PACK_NAME=
WARPATH_CHANNEL_ID=
WARPATH_APP_VERSION=
WARPATH_PACKAGE_VERSION=
WARPATH_OS_TYPE=win

# Run exactly ONE worker / ONE replica (game sessions/challenges/locks).
# Website sessions/grants/throttles are PostgreSQL-backed after migration 0004.
# Default per-user limits: 5 accounts / 5 website sessions / 2 active games.
# Admin pilot policy API changes limits; no environment auth/throttle bypass.
# --- AccountManager / worker behavior --------------------------------------
MAX_CONCURRENT_SESSIONS=5
# Phase 6: startup never connects. True/unknown values are rejected.
# An admin must grant a short-lived observation pilot per account before
# POST /accounts/{id}/connect. Grants disappear on close/restart.
# Game-changing/automatic actions remain blocked by unverified evidence.
AUTOSTART_ACTIVE_ACCOUNTS=false
# pilot = time-bounded admin observation grants (pre-launch testing)
# customer = active account owners may connect/reconnect in strict read-only mode.
# Customer mode does NOT enable farm/collect/recall/scout/scan/automatic actions.
OBSERVATION_ACCESS_MODE=pilot
SNAPSHOT_PERSIST_INTERVAL_SECONDS=60


# Server-to-server boundary between the Next.js BFF and FastAPI.
# Generate a long random value and set the SAME value in the Vercel project.
# Once configured, direct FastAPI requests (except /health) are rejected.
# Production startup rejects missing/short values. Use at least 32 random characters.
INTERNAL_PROXY_TOKEN=

# Preferred rotating encryption keyring, newest key first. Keep the legacy
# WARPATH_ENCRYPTION_KEY during migration until all environments are updated.
# Example: WARPATH_ENCRYPTION_KEYS=new_key,old_key
WARPATH_ENCRYPTION_KEYS=

# Detailed site-admin security audit retention (30-730 days).
ADMIN_AUDIT_RETENTION_DAYS=180
