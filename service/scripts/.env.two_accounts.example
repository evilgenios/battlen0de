# Copy this file to `.env.two_accounts` (same directory) and fill in real
# values for TWO accounts to run scripts/dev_two_accounts.py against the
# real Warpath game server. `.env.two_accounts` is gitignored — never commit
# it, and never paste real values from it into chat, issues, or docs.
#
# Same field meanings as the legacy bot's .env.example; each field is just
# duplicated under a WARPATH_A_ / WARPATH_B_ prefix so two accounts can
# coexist in one process's environment. See the audit's account-linking
# notes for how to obtain these values (extract_warpath_env.py against a
# Wireshark capture, or /link+/verify through the legacy Discord bot and
# reading the resulting entry out of warpath_accounts.json).

MAX_CONCURRENT_SESSIONS=5

# ---- Account A -------------------------------------------------------
WARPATH_A_APP_UID=
WARPATH_A_APP_TOKEN=
WARPATH_A_DEVICE_ID=
WARPATH_A_PROFILE_UID=
WARPATH_A_PLATFORM=22
WARPATH_A_APP_ID=
WARPATH_A_PACK_NAME=
WARPATH_A_CHANNEL_ID=
WARPATH_A_DEVICE_MODEL=win
WARPATH_A_OS_TYPE=win
WARPATH_A_OS_VERSION=
WARPATH_A_OS_LANGUAGE=ENG
WARPATH_A_PACK_LANGUAGE=ENG
WARPATH_A_TIMEZONE=0
WARPATH_A_APP_VERSION=
WARPATH_A_PACKAGE_VERSION=
WARPATH_A_ENV_ID=
WARPATH_A_SERVER_IP=34.8.3.236
WARPATH_A_SERVER_PORT=10000
WARPATH_A_LOGIN_TIMEOUT=30

# ---- Account B -------------------------------------------------------
WARPATH_B_APP_UID=
WARPATH_B_APP_TOKEN=
WARPATH_B_DEVICE_ID=
WARPATH_B_PROFILE_UID=
WARPATH_B_PLATFORM=22
WARPATH_B_APP_ID=
WARPATH_B_PACK_NAME=
WARPATH_B_CHANNEL_ID=
WARPATH_B_DEVICE_MODEL=win
WARPATH_B_OS_TYPE=win
WARPATH_B_OS_VERSION=
WARPATH_B_OS_LANGUAGE=ENG
WARPATH_B_PACK_LANGUAGE=ENG
WARPATH_B_TIMEZONE=0
WARPATH_B_APP_VERSION=
WARPATH_B_PACKAGE_VERSION=
WARPATH_B_ENV_ID=
WARPATH_B_SERVER_IP=34.8.3.236
WARPATH_B_SERVER_PORT=10000
WARPATH_B_LOGIN_TIMEOUT=30
