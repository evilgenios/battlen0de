.venv/
__pycache__/
*.py[cod]
.env
.env.local
.env.two_accounts
.env*
!.env.example
!.env.*.example
.vercel/
/tmp/
service/app/core/warpath/logs/
*.pcap
*.pcapng
*.cap
.pytest_cache/

# Generic safety net: none of these should legitimately exist in this repo
# (the backend is Postgres/Neon-only, with its own structured logging), but
# ignore them anyway so a stray one never gets committed by accident.
*.log
*.sqlite
*.sqlite3
*.db

# Node/Next.js — dashboard/.gitignore has the detailed version scoped to
# that project; this is a repo-wide backstop in case either ever appears
# outside it.
node_modules/
.next/
*.tsbuildinfo

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
